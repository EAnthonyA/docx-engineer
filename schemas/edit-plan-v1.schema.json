{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docx-engineer.local/schemas/edit-plan-v1.schema.json",
  "title": "DOCX Engineer edit plan v1",
  "description": "Bounded document edits and run formatting in selected DOCX text locations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"oneOf": [{"$ref": "#/$defs/replaceText"}, {"$ref": "#/$defs/formatBTags"}, {"$ref": "#/$defs/formatText"}, {"$ref": "#/$defs/deleteParagraphs"}, {"$ref": "#/$defs/regexReplace"}, {"$ref": "#/$defs/formatTagged"}, {"$ref": "#/$defs/setParagraphStyle"}, {"$ref": "#/$defs/formatParagraphs"}, {"$ref": "#/$defs/setParagraphLayout"}, {"$ref": "#/$defs/setParagraphNumbering"}, {"$ref": "#/$defs/setParagraphPagination"}, {"$ref": "#/$defs/deleteTableRows"}, {"$ref": "#/$defs/setTableCellFormat"}, {"$ref": "#/$defs/insertTableRows"}, {"$ref": "#/$defs/setTableRowHeight"}, {"$ref": "#/$defs/mergeTableCells"}, {"$ref": "#/$defs/setTableColumnWidth"}, {"$ref": "#/$defs/insertParagraphs"}]}
    }
  },
  "$defs": {
    "replaceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "search", "replacement", "match_case"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {"const": "replace_text"},
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["body", "tables", "headers_footers", "all"]}
        },
        "search": {"type": "string", "minLength": 1, "maxLength": 65536},
        "replacement": {"type": "string", "maxLength": 65536},
        "match_case": {"const": true}
      }
    },
    "formatBTags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "open_tag", "close_tag", "bold"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {"const": "format_b_tags"},
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["body", "tables", "headers_footers", "all"]}
        },
        "open_tag": {"const": "<B>"},
        "close_tag": {"const": "<D>"},
        "bold": {"const": true}
      }
    },
    "formatText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "search", "match_case", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "format_text"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "search": {"type": "string", "minLength": 1, "maxLength": 65536},
        "match_case": {"const": true},
        "format": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "bold": {"type": "boolean"}, "italic": {"type": "boolean"}, "underline": {"type": "boolean"}, "strike": {"type": "boolean"},
            "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "highlight": {"enum": ["black", "blue", "cyan", "darkBlue", "darkCyan", "darkGray", "darkGreen", "darkMagenta", "darkRed", "darkYellow", "green", "lightGray", "magenta", "none", "red", "white", "yellow"]},
            "font_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "size_pt": {"type": "number", "minimum": 0.5, "maximum": 1638, "multipleOf": 0.5}
          }
        }
      }
    },
    "deleteParagraphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "match"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "delete_paragraphs"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "headers_footers"]}},
        "match": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "text"],
          "properties": {
            "mode": {"enum": ["exact", "starts_with", "contains"]},
            "text": {"type": "string", "minLength": 1, "maxLength": 65536}
          }
        }
      }
    },
    "regexReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "pattern", "replacement", "case_insensitive"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "regex_replace"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 65536},
        "replacement": {"type": "string", "maxLength": 65536},
        "case_insensitive": {"type": "boolean"}
      }
    },
    "formatTagged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locations", "open_tag", "close_tag", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "format_tagged"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "open_tag": {"type": "string", "minLength": 1, "maxLength": 65536},
        "close_tag": {"type": "string", "minLength": 1, "maxLength": 65536},
        "format": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "bold": {"type": "boolean"}, "italic": {"type": "boolean"}, "underline": {"type": "boolean"}, "strike": {"type": "boolean"},
            "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "highlight": {"enum": ["black", "blue", "cyan", "darkBlue", "darkCyan", "darkGray", "darkGreen", "darkMagenta", "darkRed", "darkYellow", "green", "lightGray", "magenta", "none", "red", "white", "yellow"]},
            "font_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
            "size_pt": {"type": "number", "minimum": 0.5, "maximum": 1638, "multipleOf": 0.5}
          }
        }
      }
    },
    "setParagraphStyle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "style_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "set_paragraph_style"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "match": {
          "type": "object", "additionalProperties": false, "required": ["mode", "text"],
          "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}
        },
        "style_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
      }
    },
    "formatParagraphs": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "format_paragraphs"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "format": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"bold": {"type": "boolean"}, "italic": {"type": "boolean"}, "underline": {"type": "boolean"}, "strike": {"type": "boolean"}, "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}, "highlight": {"enum": ["black", "blue", "cyan", "darkBlue", "darkCyan", "darkGray", "darkGreen", "darkMagenta", "darkRed", "darkYellow", "green", "lightGray", "magenta", "none", "red", "white", "yellow"]}, "font_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}, "size_pt": {"type": "number", "minimum": 0.5, "maximum": 1638, "multipleOf": 0.5}}}
      }
    },
    "setParagraphLayout": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "layout"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "set_paragraph_layout"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "layout": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "alignment": {"enum": ["left", "center", "right", "justify"]},
            "space_before_pt": {"type": "number", "minimum": 0, "maximum": 1584, "multipleOf": 0.5},
            "space_after_pt": {"type": "number", "minimum": 0, "maximum": 1584, "multipleOf": 0.5},
            "left_indent_pt": {"type": "number", "minimum": 0, "maximum": 1584, "multipleOf": 0.5},
            "right_indent_pt": {"type": "number", "minimum": 0, "maximum": 1584, "multipleOf": 0.5}
          }
        }
      }
    },
    "setParagraphNumbering": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "num_id", "level"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "set_paragraph_numbering"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "num_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "level": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "setParagraphPagination": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "pagination"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "set_paragraph_pagination"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["body", "tables", "headers_footers", "all"]}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "pagination": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"keep_with_next": {"type": "boolean"}, "keep_together": {"type": "boolean"}, "page_break_before": {"type": "boolean"}}}
      }
    },
    "deleteTableRows": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "delete_table_rows"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "tables"}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}}
      }
    },
    "setTableCellFormat": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "set_table_cell_format"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "tables"}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "format": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"fill_color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}, "vertical_alignment": {"enum": ["top", "center", "bottom"]}, "border_color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}, "border_size_pt": {"type": "number", "minimum": 0.125, "maximum": 31.75, "multipleOf": 0.125}}}
      }
    },
    "insertTableRows": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "locations", "anchor", "position", "rows"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "type": {"const": "insert_table_rows"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "tables"}},
        "anchor": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "position": {"enum": ["before", "after"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["cells"], "properties": {"cells": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 65536, "pattern": "^[^\\r\\n]*$"}}}}}
      }
    },
    "setTableRowHeight": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "height_pt", "rule"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "type": {"const": "set_table_row_height"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "tables"}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "height_pt": {"type": "number", "minimum": 0.5, "maximum": 1584, "multipleOf": 0.5},
        "rule": {"enum": ["at_least", "exact"]}
      }
    },
    "mergeTableCells": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "direction", "span"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "type": {"const": "merge_table_cells"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "tables"}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "direction": {"enum": ["right", "down"]}, "span": {"type": "integer", "minimum": 2, "maximum": 64}
      }
    },
    "setTableColumnWidth": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "match", "column_index", "width_pt"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "type": {"const": "set_table_column_width"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "tables"}},
        "match": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "column_index": {"type": "integer", "minimum": 0, "maximum": 63}, "width_pt": {"type": "number", "minimum": 0.5, "maximum": 1584, "multipleOf": 0.5}
      }
    },
    "insertParagraphs": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "locations", "anchor", "position", "paragraphs"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "type": {"const": "insert_paragraphs"},
        "locations": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "body"}},
        "anchor": {"type": "object", "additionalProperties": false, "required": ["mode", "text"], "properties": {"mode": {"enum": ["exact", "starts_with", "contains"]}, "text": {"type": "string", "minLength": 1, "maxLength": 65536}}},
        "position": {"enum": ["before", "after"]},
        "paragraphs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 65536, "pattern": "^[^\\r\\n]*$"}, "style_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "page_break_before": {"type": "boolean"}, "format": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"bold": {"type": "boolean"}, "italic": {"type": "boolean"}, "underline": {"type": "boolean"}, "strike": {"type": "boolean"}, "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}, "highlight": {"enum": ["black", "blue", "cyan", "darkBlue", "darkCyan", "darkGray", "darkGreen", "darkMagenta", "darkRed", "darkYellow", "green", "lightGray", "magenta", "none", "red", "white", "yellow"]}, "font_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}, "size_pt": {"type": "number", "minimum": 0.5, "maximum": 1638, "multipleOf": 0.5}}}}}}
      }
    }
  }
}
